# ----------------------------------------------------------------
# My Village — environment variables
# Copy this file to `.env.local` and fill in real values.
# The app runs fully on seeded mock data with NONE of these set;
# fill them in to switch persistence/AI to real services.
# ----------------------------------------------------------------

# Supabase (Postgres + Storage). Leave blank to use the in-memory
# mock store. See supabase/schema.sql and supabase/seed.sql.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key for route handlers that write (never expose to client).
SUPABASE_SERVICE_ROLE_KEY=

# AI item categorization (multimodal LLM / image-classification API).
# Leave blank to use the deterministic stub in app/api/ai/extract.
# Example for Anthropic:
#   AI_PROVIDER=anthropic
#   ANTHROPIC_API_KEY=sk-ant-...
#   AI_MODEL=claude-opus-4-8
AI_PROVIDER=
ANTHROPIC_API_KEY=
AI_MODEL=
