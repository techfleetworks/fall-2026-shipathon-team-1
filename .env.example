# Server-only (Vercel env vars). Never expose these to the browser.
# Get a free key at https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=
# Comma-separated participant codes allowed to call /api/detect, e.g. P01,P02,P03
ALLOWED_PARTICIPANT_CODES=

# Public (safe in the browser; protected by Row Level Security). Written to public/config.js at build.
SUPABASE_URL=
SUPABASE_ANON_KEY=
